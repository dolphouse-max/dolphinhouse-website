---
import Layout from "../layouts/Layout.astro";
import MobileCollapsibleSection from "../components/MobileCollapsibleSection.astro";
import MobileCollapsibleEnhancer from "../components/MobileCollapsibleEnhancer.astro";

const facilityIcons = {
  'Air-conditioned rooms & cottages': '❄',
  'Attached bathrooms with geysers': '🚿',
  'Satellite TV': '📺',
  'Generator backup': '⚡',
  'Free Wi-Fi': '📶',
  'Car parking': '🅿',
  'In-house restaurant': '🍽',
  'Indoor swimming pool with waterfall': '🏊',
};
const facilities = Object.keys(facilityIcons);

const faqs = [
  {
    question: "How far is Dolphin House Beach Resort from Nagaon Beach?",
    answer: "Dolphin House Beach Resort is 2-min walk (200 meters) from Nagaon Beach main entrance - closest hotels in Alibaug near beach with swimming pool."
  },
  {
    question: "Is Dolphin House a resort with swimming pool in Alibaug?",
    answer: "Yes, Dolphin House is a resort with swimming pool in Alibaug - indoor pool with waterfall for in-house guests, best for family resort near beach."
  },
  {
    question: "What are room tariffs at Dolphin House - hotels in Alibaug near beach low price?",
    answer: "Room tariffs start from ₹2,000 Non-AC, ₹2,300 AC, ₹2,600 Deluxe, ₹3,000-3,500 Family rooms. Direct booking best rates - hotels in Alibaug near beach low price for family."
  },
  {
    question: "Is Dolphin House suitable for family near beach?",
    answer: "Yes, best family resort in Alibaug near beach - family rooms for 4-5 guests, safe flat Nagaon Beach ideal for kids, indoor pool, restaurant."
  }
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {"@type": "Answer","text": faq.answer}
  }))
};
---

<Layout 
  title="Dolphin House Beach Resort Nagaon Alibaug - Resort with Swimming Pool from ₹2000"
  description="Dolphin House Beach Resort, Nagaon Alibaug - Rated 4.1/5 (500+ reviews). Beach resort with swimming pool 2-min walk to Nagaon Beach. Family resort near beach, AC rooms from ₹2,300. Book direct."
  image="/uploader/dolphinhouse-front-4.webp" 
  ogType="website" 
  faqSchema={faqSchema}>

  <section class="hero relative mb-12 overflow-hidden">
    <img src="/uploader/dolphinhouse-front-4-700w.webp" srcset="/uploader/dolphinhouse-front-4-700w.webp 700w, /uploader/dolphinhouse-front-4-876w.webp 876w" sizes="100vw" alt="Dolphin House Beach Resort Nagaon Alibaug - Resort with swimming pool near beach" class="hero-img" width="876" height="584" />
    <div class="hero-overlay">
     <h1 class="hero-title text-3xl md:text-5xl font-extrabold uppercase leading-tight">
       Dolphin House Beach Resort, Nagaon Alibaug - Resort with Swimming Pool Near Beach
     </h1>
       <p class="hero-sub">Rated 4.1/5 (500+ reviews). Family resort near beach 2-min walk (200m) to Nagaon Beach, indoor pool with waterfall, AC rooms from ₹2,000. Book direct best rates.</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">From ₹2,000/night</span>
        <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">Swimming Pool</span>
        <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">2 Min Walk to Beach</span>
      </div>
    </div>
  </section>

  <section class="my-8 max-w-5xl mx-auto rounded-2xl border border-sky-200 bg-gradient-to-br from-sky-50 to-white p-6 shadow-sm">
    <h2 class="text-2xl font-bold text-gray-900 mb-3">Dolphin House Beach Resort - Hotels in Alibaug Near Beach with Swimming Pool</h2>
    <p class="text-gray-700">Searching for <strong>alibaug resorts near beach</strong>, <strong>hotels in alibaug near beach</strong>, <strong>resort with swimming pool in Alibaug</strong> or <strong>family resort near beach</strong>? Dolphin House is 2-min walk to Nagaon Beach, rated 4.1/5, indoor pool.</p>
    <dl class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm">
      <div class="flex gap-2"><dt class="font-semibold min-w-[120px]">📍 Location</dt><dd>Nagaon, Alibaug (NOT Goa) - hotels near Nagaon Beach</dd></div>
      <div class="flex gap-2"><dt class="font-semibold min-w-[120px]">🏖 Distance</dt><dd>2 min walk (200m) - closest beach resort near me in Alibaug</dd></div>
      <div class="flex gap-2"><dt class="font-semibold min-w-[120px]">💰 Price</dt><dd>From ₹2,000/night - alibaug hotels near beach low price</dd></div>
      <div class="flex gap-2"><dt class="font-semibold min-w-[120px]">🏊 Pool</dt><dd>Indoor pool with waterfall - swimming pool nagaon</dd></div>
    </dl>
  </section>

  <MobileCollapsibleSection title="Stay at Dolphin House - Family Resort Near Beach" class="section bg-sky-50">
    <div class="container text-center">
      <h2 class="text-3xl font-bold">Alibaug Resorts Near Beach for Family - Hotels in Alibaug Near Beach</h2>
      <p class="mt-3 text-gray-600 max-w-3xl mx-auto">Top-rated <strong>alibaug resorts near beach</strong> for family with swimming pool, 2-min walk to Nagaon Beach. AC rooms, family rooms, restaurant.</p>
      <div class="grid md:grid-cols-2 gap-8 mt-8">
        <div class="card"><img src="/uploader/hotel-front-1-480x320.webp" alt="Dolphin House Beach Resort Nagaon Alibaug - hotels in alibaug near beach" class="card-img" loading="lazy" /><div class="card-overlay"><h3 class="card-title">Resort View - Family Resort Near Beach</h3></div></div>
        <div class="card"><img src="/uploader/swimming-pool1-480x320.webp" alt="Indoor swimming pool at Dolphin House - resort with swimming pool Alibaug" class="card-img" loading="lazy" /><div class="card-overlay"><h3 class="card-title">Indoor Pool - Resort with Swimming Pool</h3></div></div>
      </div>
      <a href="/rooms" class="btn-primary mt-8 inline-block">View Rooms from ₹2,000 - Hotels Near Beach</a>
    </div>
  </MobileCollapsibleSection>

  <MobileCollapsibleSection title="Frequently Asked Questions - Alibaug Resorts Near Beach" class="section">
    <div class="container max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center">FAQs - Dolphin House Beach Resort</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border bg-white p-5 shadow-sm">
            <summary class="flex justify-between font-semibold cursor-pointer list-none"><span>{faq.question}</span><span class="text-sky-600">+</span></summary>
            <p class="mt-3 text-gray-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </MobileCollapsibleSection>

  <MobileCollapsibleEnhancer />
</Layout>
