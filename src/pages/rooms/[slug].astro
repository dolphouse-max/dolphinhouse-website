export function getStaticPaths() {
  return Object.keys(roomPages).map((slug) => ({
    params: { slug },
    props: { roomPage: roomPages[slug] }
  }));
}

const { roomPage } = Astro.props;
---

<Layout
  title={`${roomPage.title} | Dolphin House Beach Resort`}
  description={roomPage.description}
  image={roomPage.heroImage}
  ogType="hotel"
>
  <section class="mb-10">
    <a href="/rooms" class="inline-flex items-center rounded-full border border-sky-200 bg-white px-4 py-2 text-sm font-semibold text-sky-700 transition hover:border-sky-400 hover:bg-sky-50">
      Back to Rooms
    </a>
  </section>

  <section class="mb-12 overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-gray-100">
    <div class="relative">
      <img
        src={roomPage.heroImage}
        alt={roomPage.heading}
        class="h-80 w-full object-cover md:h-[460px]"
        width="1600"
        height="1067"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/70 via-black/20 to-transparent">
        <div class="max-w-4xl p-6 md:p-10">
          <h1 class="text-3xl font-extrabold tracking-tight text-white md:text-5xl">{roomPage.heading}</h1>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/90 md:text-lg">{roomPage.description}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-12">
    {roomPage.groups.map((group, groupIndex) => (
      <article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg" data-slider>
        <div class="border-b border-gray-100 px-5 py-4 md:px-6">
          <h2 class="text-2xl font-bold text-gray-900">{group.name}</h2>
        </div>

        <div class="relative bg-gray-950">
          {group.images.map((image, imageIndex) => (
            <img
              src={image}
              alt={`${group.name} photo ${imageIndex + 1}`}
              class:list={[
                "slider-image h-72 w-full object-contain md:h-[560px]",
                imageIndex === 0 ? "block" : "hidden"
              ]}
              width="1600"
              height="1067"
              loading={groupIndex === 0 && imageIndex === 0 ? "eager" : "lazy"}
              decoding="async"
              data-slide={imageIndex}
            />
          ))}

          <button type="button" class="slider-prev absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-2xl font-bold text-gray-900 shadow-md transition hover:bg-white" aria-label={`Previous ${group.name} photo`}>
            ‹
          </button>
          <button type="button" class="slider-next absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-2xl font-bold text-gray-900 shadow-md transition hover:bg-white" aria-label={`Next ${group.name} photo`}>
            ›
          </button>

          <div class="absolute bottom-3 right-3 rounded-full bg-black/65 px-3 py-1 text-sm font-semibold text-white">
            <span data-current>1</span> / {group.images.length}
          </div>
        </div>

        <div class="flex gap-3 overflow-x-auto p-4 md:p-5">
          {group.images.map((image, imageIndex) => (
            <button
              type="button"
              class:list={[
                "slider-thumb h-20 w-28 shrink-0 overflow-hidden rounded-lg border-2 transition md:h-24 md:w-36",
                imageIndex === 0 ? "border-sky-600" : "border-transparent"
              ]}
              data-thumb={imageIndex}
              aria-label={`Show ${group.name} photo ${imageIndex + 1}`}
            >
              <img src={image} alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="mt-12 flex flex-wrap justify-center gap-3">
    <a href="/rooms" class="rounded-full border border-sky-200 bg-white px-5 py-3 font-semibold text-sky-700 transition hover:border-sky-400 hover:bg-sky-50">
      View All Room Categories
    </a>
    <a href="/booking" class="rounded-full bg-sky-600 px-5 py-3 font-semibold text-white shadow-md transition hover:bg-sky-700">
      Check Availability
    </a>
  </section>

  <script>
    document.querySelectorAll("[data-slider]").forEach((slider) => {
      const slides = Array.from(slider.querySelectorAll("[data-slide]"));
      const thumbs = Array.from(slider.querySelectorAll("[data-thumb]"));
      const current = slider.querySelector("[data-current]");
      const prev = slider.querySelector(".slider-prev");
      const next = slider.querySelector(".slider-next");
      let activeIndex = 0;

      const showSlide = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          slide.classList.toggle("hidden", index !== activeIndex);
          slide.classList.toggle("block", index === activeIndex);
        });
        thumbs.forEach((thumb, index) => {
          thumb.classList.toggle("border-sky-600", index === activeIndex);
          thumb.classList.toggle("border-transparent", index !== activeIndex);
        });
        if (current) current.textContent = String(activeIndex + 1);
      };

      prev?.addEventListener("click", () => showSlide(activeIndex - 1));
      next?.addEventListener("click", () => showSlide(activeIndex + 1));
      thumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => showSlide(index));
      });
    });
  </script>
</Layout>
