---
import Layout from "../layouts/Layout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Dolphin House have a swimming pool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Dolphin House has an indoor swimming pool with waterfall feature, open 8am to 8pm for in-house guests. Depth 3.5ft to 5ft, safe for kids with supervision."
      }
    },
    {
      "@type": "Question",
      "name": "Why book a resort with swimming pool in Alibaug?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Alibaug beaches have high tide variations. A resort with swimming pool gives you guaranteed swim time even during high tide or after sunset, plus safe play for kids."
      }
    },
    {
      "@type": "Question",
      "name": "What are pool timings and is it safe for family?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pool timings 8am-8pm, filtered water, lifebuoy and seating area. Family-safe with shallow end for kids, indoor setup avoids direct sun."
      }
    }
  ]
};

const lodgingSchema = {
  "@context": "https://schema.org",
  "@type": ["LodgingBusiness","Hotel"],
  "name": "Dolphin House Beach Resort - Resort with Swimming Pool in Alibaug",
  "url": "https://dolphinhouse-alibaug.com/resort-with-swimming-pool-alibaug",
  "image": [
    "https://dolphinhouse-alibaug.com/uploader/swimming-pool1.webp",
    "https://dolphinhouse-alibaug.com/uploader/swimming-pool2.webp"
  ],
  "telephone": "+91-8554871073",
  "priceRange": "₹2000-3500",
  "amenityFeature": [
    {"@type":"LocationFeatureSpecification","name":"Indoor swimming pool with waterfall","value":true},
    {"@type":"LocationFeatureSpecification","name":"Family-safe pool","value":true}
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1317, Nagaon Bandar Road, Nagaon",
    "addressLocality": "Alibag",
    "addressRegion": "Maharashtra",
    "postalCode": "402204",
    "addressCountry": "IN"
  }
};
---

<Layout
  title="Resort with Swimming Pool in Alibaug | Dolphin House Indoor Pool"
  description="Resort with swimming pool in Alibaug - Dolphin House indoor pool with waterfall, 8am-8pm timings, family-safe. Pool + beach combo 2-min walk to Nagaon Beach, rooms from ₹2000."
  image="/uploader/swimming-pool1.webp"
  canonical="https://dolphinhouse-alibaug.com/resort-with-swimming-pool-alibaug"
  ogType="article"
  faqSchema={[faqSchema, lodgingSchema]}
>
  <section class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900">Resort with Swimming Pool in Alibaug - Indoor Pool at Dolphin House</h1>
    <p class="mt-4 text-lg text-gray-600">Looking for a <strong>resort with swimming pool in Alibaug</strong> that also keeps beach walkable? Dolphin House offers indoor pool with waterfall, 200m to Nagaon Beach, family rooms from ₹2000.</p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-6">
    <div class="grid md:grid-cols-4 gap-4">
      <img src="/uploader/swimming-pool1.webp" alt="Indoor swimming pool with waterfall at Dolphin House resort Alibaug" class="rounded-2xl h-56 w-full object-cover" />
      <img src="/uploader/swimming-pool1_1.webp" alt="Swimming pool seating area at resort with swimming pool Alibaug" class="rounded-2xl h-56 w-full object-cover" />
      <img src="/uploader/swimming-pool2.webp" alt="Indoor pool view at Dolphin House resort with swimming pool" class="rounded-2xl h-56 w-full object-cover" />
      <img src="/uploader/swimming-pool3.webp" alt="Pool with waterfall at resort with swimming pool in Alibaug" class="rounded-2xl h-56 w-full object-cover" />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8 bg-sky-50 rounded-2xl border">
    <h2 class="text-2xl font-bold">Pool Timings & Family Safety</h2>
    <ul class="mt-4 space-y-2 text-gray-700">
      <li><strong>Timings:</strong> 8am - 8pm, filtered water, daily cleaning</li>
      <li><strong>Depth:</strong> 3.5ft shallow end for kids, 5ft deep end, lifebuoy available</li>
      <li><strong>Indoor advantage:</strong> No direct sun, usable even during rain or high tide beach closure</li>
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold">Why Pool + Beach Combo Matters in Alibaug</h2>
    <p class="mt-3 text-gray-700">Alibaug beaches have 3-4 hour high-tide no-swim windows. Resorts without pool leave you stuck in room. With Dolphin House you get both: 2-min walk to Nagaon Beach for morning water sports (parasailing, jet-ski, banana ride) and indoor pool for evening family time after sunset.</p>
    <p class="mt-3 text-gray-700">Unlike resorts where pool is far from rooms, our pool is central, visible from restaurant, so parents can relax while kids swim.</p>
  </section>
</Layout>
