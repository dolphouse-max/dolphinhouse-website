  "isPartOf": {
    "@type": "WebSite",
    "name": "Dolphin House Beach Resort",
    "url": "https://dolphinhouse-alibaug.com"
  },
  "about": [
    { "@type": "Thing", "name": "Nagaon Beach" },
    { "@type": "Thing", "name": "Alibaug" },
    { "@type": "Thing", "name": "Beach resort with swimming pool" }
  ],
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "https://dolphinhouse-alibaug.com/uploader/nagaon-beach.webp"
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".aeo-answer", ".quick-facts"]
  },
  "mainEntity": {
    "@type": "Hotel",
    "name": "Dolphin House Beach Resort",
    "url": "https://dolphinhouse-alibaug.com/nagaon-beach-resort",
