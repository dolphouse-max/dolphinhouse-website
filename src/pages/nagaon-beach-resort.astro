---
import Layout from "../layouts/Layout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why stay in Nagaon instead of Alibaug city?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nagaon offers cleaner sand, flat safe beach for kids, and direct water sports (parasailing, jet-ski, banana ride) without traveling to other beaches. Alibaug city beaches are crowded and have more boat traffic."
      }
    },
    {
      "@type": "Question",
      "name": "What water sports are available at Nagaon Beach?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Parasailing, jet-ski rides, banana boat rides, bumper rides and kayaking operate 10am-6pm at main Nagaon Beach, 2-min walk from Dolphin House."
      }
    },
    {
      "@type": "Question",
      "name": "Is Nagaon Beach safe for kids?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Nagaon Beach is flat for 200-300m during low tide with shallow water, no sudden depth drop, making it safer for kids vs Alibaug city beaches."
      }
    }
  ]
};

const lodgingSchema = {
  "@context": "https://schema.org",
  "@type": ["LodgingBusiness","Hotel"],
  "name": "Dolphin House Beach Resort - Nagaon Beach Resort",
  "url": "https://dolphinhouse-alibaug.com/nagaon-beach-resort",
  "image": "https://dolphinhouse-alibaug.com/uploader/nagaon-beach.webp",
  "telephone": "+91-8554871073",
  "priceRange": "₹2000-3500",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1317, Nagaon Bandar Road, Nagaon",
    "addressLocality": "Alibag",
    "addressRegion": "Maharashtra",
    "postalCode": "402204",
    "addressCountry": "IN"
  },
  "geo": {"@type":"GeoCoordinates","latitude":18.5830,"longitude":72.9028}
};
---

<Layout
  title="Nagaon Beach Resort | Dolphin House - 2 min walk to beach"
  description="Nagaon Beach Resort 2-min walk (200m) to beach. Why Nagaon vs Alibaug city, flat safe beach for kids, parasailing, jet-ski, banana ride. Family rooms from ₹2000."
  image="/uploader/nagaon-beach.webp"
  canonical="https://dolphinhouse-alibaug.com/nagaon-beach-resort"
  ogType="article"
  faqSchema={[faqSchema, lodgingSchema]}
>
  <section class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900">Nagaon Beach Resort - Stay 2 mins from Nagaon Beach</h1>
    <p class="mt-4 text-lg text-gray-600">Dolphin House is <strong>200m, 2-min walk</strong> to Nagaon Beach main entrance. Built for travelers who specifically want Nagaon, not Alibaug city crowd.</p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-6 bg-sky-50 rounded-2xl border">
    <h2 class="text-2xl font-bold">Why Nagaon vs Alibaug City?</h2>
    <div class="mt-4 grid md:grid-cols-2 gap-4 text-gray-700">
      <div class="bg-white p-4 rounded-xl border"><strong>Nagaon:</strong> Cleaner sand, quieter, flat beach, water sports hub, family stays.</div>
      <div class="bg-white p-4 rounded-xl border"><strong>Alibaug City:</strong> Crowded, jetty traffic, fewer safe swimming patches, auto rides needed.</div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="text-2xl font-bold">Water Sports at Nagaon Beach</h2>
    <ul class="mt-4 grid md:grid-cols-3 gap-3">
      <li class="p-4 bg-white border rounded-xl"><strong>Parasailing</strong> - 5-7 min tandem flight</li>
      <li class="p-4 bg-white border rounded-xl"><strong>Jet-Ski</strong> - 10 min solo/duo ride</li>
      <li class="p-4 bg-white border rounded-xl"><strong>Banana Ride</strong> - Family/group, 10 min</li>
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8 bg-emerald-50 rounded-2xl border border-emerald-100">
    <h2 class="text-2xl font-bold text-emerald-950">Flat Safe Beach for Kids</h2>
    <p class="mt-3 text-gray-700">Nagaon Beach is flat 200-300m during low tide, shallow, no sudden depth. Ideal for kids and elders vs Revdanda or city beaches. Dolphin House adds indoor pool with waterfall for after-beach swim.</p>
  </section>
</Layout>
