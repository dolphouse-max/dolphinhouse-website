---
import Layout from "../layouts/Layout.astro";

const tourUrl = "https://tourmkr.com/F1cOqIp6Mh/47916707p&0h&90t";
---

<Layout
  title="360° Virtual Tour | Dolphin House Beach Resort"
  description="Explore Dolphin House Beach Resort in Nagaon, Alibaug with our interactive 360° virtual tour. View rooms, pool, dining area and resort surroundings."
  image="/uploader/dolphinhouse-front-4.webp"
  ogType="hotel"
>
  <section class="mb-10 text-center">
    <p class="mb-3 text-sm font-bold uppercase tracking-wide text-sky-600">Virtual Resort Walkthrough</p>
    <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 md:text-6xl">
      360° Virtual Tour of Dolphin House Beach Resort
    </h1>
    <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-gray-600">
      Explore Dolphin House Beach Resort before you book. Walk through the main entrance,
      dining area, rooms, swimming pool, and resort surroundings from your phone or desktop.
    </p>
  </section>

  <section class="mx-auto max-w-6xl overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl">
    <div class="relative w-full bg-gray-950" style="aspect-ratio: 16 / 9; min-height: 320px;">
      <iframe
        src={tourUrl}
        title="360 degree virtual tour of Dolphin House Beach Resort in Nagaon Alibaug"
        loading="lazy"
        allowfullscreen
        class="absolute inset-0 h-full w-full border-0"
      ></iframe>
    </div>
    <div class="border-t border-gray-100 p-5 text-center md:p-6">
      <p class="text-sm leading-relaxed text-gray-600">
        If the tour does not load in your browser, open it directly in a new tab.
      </p>
      <a
        href={tourUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block rounded-full bg-sky-600 px-6 py-3 font-semibold text-white shadow transition hover:bg-sky-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600"
      >
        Open 360° Virtual Tour
      </a>
    </div>
  </section>

  <section class="mx-auto mt-12 max-w-4xl rounded-3xl border border-sky-100 bg-sky-50 p-8 text-center shadow-sm">
    <h2 class="text-3xl font-bold text-gray-900">Like What You See?</h2>
    <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-gray-700">
      Check our rooms and plan your stay at Dolphin House Beach Resort.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="/rooms"
        class="rounded-full border border-sky-200 bg-white px-5 py-3 font-semibold text-sky-700 transition hover:border-sky-400 hover:bg-sky-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600"
      >
        View Rooms
      </a>
      <a
        href="/booking"
        class="rounded-full bg-sky-600 px-5 py-3 font-semibold text-white shadow-md transition hover:bg-sky-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600"
      >
        Check Availability
      </a>
    </div>
  </section>
</Layout>
